<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>FogOfPawn_DisguiseKit</defName>
    <label>disguise kit</label>
    <category>Item</category>
    <thingClass>Apparel</thingClass>
    <description>A collection of cheap props, wigs, and makeup used by imposters to hide their true identity. When worn, this kit reduces the wearer's apparent value to the colony, making them seem less wealthy than they actually are. Finding this item indicates that someone in your colony was not who they claimed to be.</description>
    <graphicData>
      <texPath>Things/Item/disguise-kit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.0,1.0)</drawSize>
    </graphicData>
    <selectable>true</selectable>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <statBases>
      <MarketValue>1</MarketValue>
      <Mass>0.1</Mass>
      <MaxHitPoints>120</MaxHitPoints>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <useHitPoints>true</useHitPoints>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>OuterClothing</li>
      </layers>
      <tags>
        <li>Utility</li>
      </tags>
    </apparel>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="FogOfPawn.CompProperties_DisguiseKitWealth" />
    </comps>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <alwaysHaulable>true</alwaysHaulable>
    <rotatable>false</rotatable>
    <fillPercent>0.3</fillPercent>
    <pathCost>14</pathCost>
    <soundInteract>Standard_Pickup</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
  </ThingDef>
</Defs> 